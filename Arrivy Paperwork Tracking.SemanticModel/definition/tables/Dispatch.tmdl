		source =
				let
				    Source = Sql.Database("PLNDS01\SQL2k16", "MoversSuite2Supp", [Query="USE [MoversSuite2Supp];#(lf)#(lf)-- Calculate the two Saturdays relative to today#(lf)DECLARE @Today    DATE  = CAST(GETDATE() AS DATE);#(lf)DECLARE @Offset   INT   = DATEPART(WEEKDAY, @Today) % 7;#(lf)SET    @Offset   = CASE WHEN @Offset = 0 THEN 7 ELSE @Offset END;#(lf)DECLARE @EndDt    DATE#(lf)DECLARE @StartDt  DATE#(lf)#(lf) Set @StartDt ='2026-06-28';#(lf) Set @EndDt = @Today;#(lf)#(lf)SET NOCOUNT ON;#(lf)DECLARE @Interim table #(lf)#(tab)(EquipNo varchar(40),#(lf)#(tab)EquipType varchar(100),#(lf)#(tab)EqStatus varchar(100),#(lf)#(tab)Branch varchar(100),#(lf)#(tab)Owner varchar(100),#(lf)    OrderNo varchar(20),#(lf)#(tab)Ordprikey INT,#(lf)#(tab)ServiceType varchar(200),#(lf)#(tab)ServiceID varchar(100),#(lf)#(tab)ShipperName varchar(100), #(lf)    LocSerPriKey VARCHAR (50), #(lf)#(tab)ScheduledStart datetime#(lf)#(lf)#(tab))#(lf)#(lf)#(tab)insert into @Interim#(lf)          select #(lf)#(tab)#(tab)  Equip.EqNo,#(lf)#(tab)#(tab)  EqType.Type,#(lf)#(tab)#(tab)  Equip.EqStatus,#(lf)#(tab)#(tab) CASE#(lf)           WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo)) = '1840' THEN 'Cincinnati'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo)) = '40' THEN 'Cincinnati'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '140' THEN 'Indianapolis'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))='1843' THEN 'Indianapolis'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '340' THEN 'Chicago'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '35' THEN 'Columbus'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '402' THEN 'Dayton'#(lf)#(tab)#(tab)   WHEN ISNULL(Equip.EqNo,'') like 'Hogan%' THEN 'Columbus'#(lf)#(tab)#(tab)   WHEN ISNULL(Equip.EqNo,'') like '%Ideal%' THEN 'Columbus'#(lf)#(tab)#(tab)   WHEN ISNULL(Equip.EqNo,'') like 'Rental%' THEN 'Cincinnati'#(lf)#(tab)#(tab)   WHEN ISNULL(Equip.EqNo,'') like 'R%' THEN 'Cincinnati'#(lf)           ELSE ''#(lf)        END AS branch,#(lf)#(tab)#(tab)   Equip.RegisteredOwner,#(lf)#(tab)#(tab)  VWO.OrderNo, #(lf)#(tab)#(tab)  VWO.OrdPriKey,#(lf)#(tab)#(tab)  ServType.Service,#(lf)#(tab)#(tab)  ServType.ServiceID,#(lf)          VWO.Shipper AS ShipperName,#(lf)          LocServ.PriKey LocServPriKey, #(lf)          LSE.ScheduledStart#(lf)   from MoversSuite2..Equip #(lf)   left join MoversSuite2..LocalServicesEquipment LSE#(lf)      on Equip.EqNo = LSE.EquipmentNumber#(lf)   left join MoversSuite2..EqType #(lf)      on Equip.Type=EqType.TypeNumber#(lf)   Left join MoversSuite2..LocServ#(lf)      on LSE.LocalServicesEquipmentLocServFID = LocServ.PriKey#(lf)   Left join MoversSuite2Supp..vwOrdersDataset VWO#(lf)      on LocServ.OrdPriKey = VWO.OrdPriKey#(lf)   left join MoversSuite2..LocalServicesCrew#(lf)      on LocServ.PriKey = LocalServicesCrew.LocalServicesCrewLocServFID #(lf)      and LeadMan = 1#(lf)   left join MoversSuite2..ServType#(lf)      on LocServ.ServiceID = ServType.ServiceID #(lf) where LSE.ScheduledStart between @StartDt and @EndDt#(lf) and Equip.EqStatus='1'#(lf)  and ServType.Service not in ('Vaulted storage','Intl transload','Training','Non-billable',                                       #(lf)                                'WHSE SIT In', 'WHSE SIT Out')#(lf)#(lf)select * FROM @Interim#(lf)         where ServiceID is not null#(lf) AND ScheduledStart > '2026-06-27'", HierarchicalNavigation=true]),
