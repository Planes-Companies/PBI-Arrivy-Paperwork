	partition Crew = m
		mode: import
		source =
				let
				  Source = Sql.Database("PLNDS01\sql2k16", "MoversSuite2Supp", [Query="SELECT VWO.[ServiceDate]#(lf)      ,[CustomerName]#(lf)      ,[OrdPriKey]#(lf)      ,[OrderNo]#(lf)      ,VWO.[Service]#(lf)      ,[NumOfCrew]#(lf)      ,[TotCrewHrs]#(lf)      ,VWO.[TotalCrew]#(lf)      ,[LocServPriKey]#(lf)      ,[ActTotalHrs]#(lf)      ,[Crew]#(lf)      ,[WorkTicket]#(lf)  FROM [MoversSuite2Supp].[dbo].[vwLocalServices] VWO#(lf)  LEFT JOIN MoversSuite2..LocalServices LS#(lf)  ON VWO.LocServPriKey = LS.LocalServicesLocServFID#(lf)  WHERE VWO.ServiceDate > '2026-06-28'#(lf)  AND VWO.Service NOT IN ('Training','Facilities Management','WHSE-Enter Time sheet in WTT')", HierarchicalNavigation=true]),
