				    #"Expanded PlanesDates" = Table.ExpandTableColumn(#"Merged Queries", "PlanesDates", {"PlanesDateID"}, {"PlanesDates.PlanesDateID"}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Expanded PlanesDates", "Merged", each Text.Combine({Text.From([PlanesDates.PlanesDateID], "en-US"), " | ", Text.From([OrdPriKey], "en-US")})),
				    #"Inserted Merged Column1" = Table.AddColumn(#"Inserted Merged Column", "Merged.1", each Text.Combine({[Merged], " | ", Text.From([LocServPriKey], "en-US")})),
				    #"Renamed Columns" = Table.RenameColumns(#"Inserted Merged Column1",{{"Merged", "Date_Order"}, {"Merged.1", "Dater_Order_LocServ"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns",{{"WorkTicket", Int64.Type}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type1", each ([WorkTicket] <> null)),
				    #"Inserted Merged Column2" = Table.AddColumn(#"Filtered Rows", "Order_WT", each Text.Combine({Text.From([OrdPriKey], "en-US"), "|", Text.From([WorkTicket], "en-US")}))
				in
