	partition 'BaseDocs (Do Not Alter)' = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("PLNDS01\sql2k16", "MoversSuite2", [Query="#(lf)DECLARE @DocumentCount TABLE (#(lf)    [MSSDocumentID] INT,#(lf)    [OrderFID] INT,#(lf)    [DocumentName] VARCHAR(500),#(lf)    [SysUserFID] INT,#(lf)    [UploadDateTime] DATETIME,#(lf)    [MSSDocumentImageFID] INT,#(lf)    [DocumentTypeFID] INT,#(lf)    [DocumentDescription] VARCHAR(100),#(lf)    [DeletedOn] DATETIME,#(lf)    [DocByteSize] INT,#(lf)#(tab)Orderno VarChar (23),#(lf)#(tab)BranchFID int,#(lf)#(tab)BranchID VarChar (5),#(lf)#(tab)Authority VarChar (30),#(lf)#(tab)Vertical VarChar (30),#(lf)#(tab)MoveTypeFID Int,#(lf)#(tab)MoveType VarChar(25),#(lf)#(tab)ProfileName VarChar (25)#(lf));#(lf)#(lf)-- Insert data from source table#(lf)INSERT INTO @DocumentCount (#(lf)    [MSSDocumentID], [OrderFID], [DocumentName], [SysUserFID],#(lf)    [UploadDateTime], [MSSDocumentImageFID],#(lf)    [DocumentTypeFID], [DocumentDescription], [DeletedOn],#(lf)    [DocByteSize], Orderno, BranchFID, BranchID, Authority, Vertical, MoveTypeFID, MoveType, ProfileName#(lf))#(lf)SELECT#(lf)    [MSSDocumentID], [OrderFID], [DocumentName], [SysUserFID],#(lf)    [UploadDateTime], [MSSDocumentImageFID],#(lf)    [DocumentTypeFID], [DocumentDescription], [DeletedOn],#(lf)    [DocByteSize], Orderno, BranchFID, BranchID, Authority, Vertical, MoveTypeFID, MoveType, ProfileName#(lf)#(lf)FROM [MoversSuite2].[dbo].[MSSDocument] MSD#(lf)LEFT JOIN MoversSuite2Supp..vwOrdersDataset VW#(lf)ON MSD.OrderFID = VW.OrdPriKey#(lf)WHERE DocumentTypeFID IN ('1','12','20','49','95')#(lf)  AND UploadDateTime > '2026-06-28' #(lf)  --AND MoveType IN ('N/A Own Local', 'N/A OWN Local', 'COD OWN Local', 'Oth Ag OWN Loca',#(lf)  --'MIL OWN Local', 'Comm Sub', 'Comm Main', 'N/A Converted', 'OAg OWN OA/DA', 'COD Box Delv')#(lf)#(lf)SELECT * FROM @DocumentCount;", HierarchicalNavigation=true]),
