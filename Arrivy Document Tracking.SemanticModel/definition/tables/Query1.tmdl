	partition Query1 = m
		mode: import
		source =
				let
				    Source = Sql.Database("PLNDS01\sql2k16", "MoversSuite2Supp", [Query="USE MoversSuite2Supp#(lf)#(lf)SELECT VLS.ServiceDate#(lf)#(tab),VOD.OrdPriKey#(lf)#(tab),vls.OrderNo#(lf)#(tab),LSO.Service#(lf)#(tab),LocServPriKey#(lf)#(tab),VLS.Crew#(lf)#(tab),VOD.BranchID#(lf)#(tab),VOD.BranchName#(lf)#(tab),VOD.BranchPrefix#(lf)#(tab),LSO.ServiceStatus#(lf)#(tab),LSO.LocServBranchName#(lf)#(tab),VOD.OrderNo#(lf)#(tab),LSE.EquipmentNumber#(lf)FROM MoversSuite2Supp..vwLocalServices VLS#(lf)JOIN vwOrdersDataset VOD#(lf)ON VLS.OrdPriKey = VOD.OrdPriKey#(lf)JOIN Moverssuite2..LocalServicesEquipment LSE#(lf)ON VLS.LocServPriKey = LSE.LocalServicesEquipmentLocServFID#(lf)JOIN MoversSuite2..LocalServices LSO#(lf)ON VLS.OrdPriKey = LSO.LocalServicesOrdersFID#(lf)WHERE vls.ServiceDate > '2026-06-13'", HierarchicalNavigation=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

