table _Measures
	lineageTag: 71f3804e-8cb7-42e8-be0b-28a265371272

	measure 'Total Orders' = DISTINCTCOUNT(vwOrdersDataset[OrdPriKey])
		formatString: 0
		lineageTag: 2ab67d98-370c-4040-829b-1336f0f57efc

	measure 'Total Work Tickets' =
			
			DISTINCTCOUNT(WorkTicketPivot[Work_Ticket])
		formatString: 0
		lineageTag: d8f5792b-32c5-4c56-800e-1301265b4d77

	measure 'Complete Work Tickets' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(WorkTicketPivot[Work_Ticket]),
			    WorkTicketPivot[DocumentStatus] = "Complete"
			)
			
			```
		formatString: 0
		lineageTag: 1f1181de-8c25-4cc0-808c-cf27ae915a3a

	measure 'Missing Pre Trip Count' = ```
			
			SUM(WorkTicketPivot[Missing Pre Trip])
			
			```
		formatString: 0
		lineageTag: 23722d81-cd27-4301-927d-3c8b9364c129

	measure 'Missing Post Trip Count' = ```
			
			SUM(WorkTicketPivot[Missing Post Trip])
			
			```
		formatString: 0
		lineageTag: 959f50d3-3ec8-41b2-8bb6-79e32b6951e7

	measure 'Tickets With BOL' = ```
			
			COUNTROWS(
			    FILTER(
			        WorkTicketPivot,
			        NOT ISBLANK(WorkTicketPivot[BOL])
			    )
			)
			
			```
		formatString: 0
		lineageTag: 3d47ba47-c878-456b-a654-746693d14849

	measure '% Missing BOL' =
			
			DIVIDE(
			    SUM('WorkTicketPivot'[Missing BOL]),
			    [Total Work Tickets]
			)
		lineageTag: af522643-a795-4155-a3cf-0874c6c83449

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Missing Pre Trip' =
			
			DIVIDE(
			    SUM('WorkTicketPivot'[Missing Pre Trip]),
			    [Total Work Tickets]
			)
		lineageTag: 4084b5a6-d614-4157-a72f-19cd2fed91d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Missing Post Trip' =
			
			DIVIDE(
			    SUM('WorkTicketPivot'[Missing Post Trip]),
			    [Total Work Tickets]
			)
		lineageTag: 5ab99485-c2ab-4dd6-b142-aa248af09f23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Complete' =
			
			DIVIDE(
			    ([Complete Work Tickets]),
			    [Total Work Tickets]
			)
		lineageTag: 0f573b94-09f0-49be-86b7-863a3d478e97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Blank Tickets' =
			
			COUNTROWS(
			FILTER(
			WorkTicketPivot,
			ISBLANK(WorkTicketPivot[Work_Ticket])
			)
			)
		formatString: 0
		lineageTag: ae00f045-dbba-475a-a78e-b478dacec175

	measure 'Missing BOL' = SUM(WorkTicketPivot[Missing BOL])
		formatString: 0
		lineageTag: cf39b994-34fd-438c-a767-fd3362702bfc

	measure 'Avg Days to BOL' =
			
			DIVIDE(
			    SUM('WorkTicketPivot'[Days to BOL]),
			    [Total Work Tickets]
			)
		lineageTag: da49cfb2-a263-474a-b164-5e9509459b61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

