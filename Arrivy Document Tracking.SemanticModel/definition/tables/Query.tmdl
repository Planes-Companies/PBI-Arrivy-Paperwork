	partition Query = m
		mode: import
		source =
				let
				  Source = Sql.Database("PLNDS01\sql2k16", "MoversSuite2", [Query="SELECT [WorkTicketID]#(lf)      ,[OrdersPriKey], [OrderNo]#(lf)#(tab)  ,vls.ServiceDate#(lf), vls.crew#(lf)      ,wt.[LocServPriKey]#(lf)      ,[WorkTicketNumber]#(lf)      ,ls.BranchPriKey#(lf)#(tab)  ,BL.Name#(lf)  FROM [MoversSuite2].[dbo].[WorkTickets] wt#(lf)  JOIN MoversSuite2Supp..vwLocalServices vls#(lf)  ON wt.LocServPriKey = vls.LocServPriKey#(lf)  #(lf)  Left join MoversSuite2..LocServ LS#(lf)#(tab)#(tab)on vls.LocServPriKey = LS.PriKey#(lf)#(lf)#(tab)Left join MoversSuite2..Branch BL#(lf)#(tab)#(tab)on LS.BranchPriKey = BL.BranchPriKey#(lf)#(lf)  WHERE OrdersPriKey > 910000", HierarchicalNavigation=true]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Name", "ServiceBranch"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Ord_WorkTicket", each Text.From([OrdersPriKey]) & "|" & Text.From([WorkTicketNumber])),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"ServiceDate", type date}, {"WorkTicketNumber", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

