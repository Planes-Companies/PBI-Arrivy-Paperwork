	partition WorkTicketPivot = m
		mode: import
		source =
				let
				    Source = Append1,
				
				    #"Removed Columns" =
				        Table.RemoveColumns(Source,{"MSSDocumentID", "DocumentName", "SysUserFID", "DocumentTypeFID", "DocumentDescription", "BranchFID", "Authority", "MoveTypeFID", "ProfileName", "NameMatch", "Stitched", "Merged", "PlanesDates.PlanesDateID", "OrderK_WorkT_Dim", "DocuSort", "DupCheck", "Upload_Date", "Upload_Time", "WorkTicket_ColLength", "LEN_Filter"}),
				
				    #"Pivoted Column" =
				        Table.Pivot(
				            #"Removed Columns",
				            List.Distinct(#"Removed Columns"[DocType]),
				            "DocType",
				            "UploadDateTime",
				            List.Min
				        ),
				
				    #"Added Hours_PreTrip_To_BOL" =
				        Table.AddColumn(
				            #"Pivoted Column",
				            "Hours_PreTrip_To_BOL",
				            each
				                if [Pre Trip] = null or [BOL] = null
				                then null
				                else Duration.TotalHours([BOL] - [Pre Trip]),
				            type number
				        ),
				    #"Added Hours_PreTrip_To_PostTrip" =
				        Table.AddColumn(
				            #"Added Hours_PreTrip_To_BOL",
				            "Hours_PreTrip_To_PostTrip",
				            each
				                if [Pre Trip] = null or [Post Trip] = null
				                then null
				                else Duration.TotalHours([Post Trip] - [Pre Trip]),
				            type number
				        ),
				
				    #"Added Hours_BOL_To_Post" =
				        Table.AddColumn(
				            #"Added Hours_PreTrip_To_PostTrip",
				            "Hours_BOL_To_Post",
				            each
				                if [BOL] = null or [Post Trip] = null
				                then null
				                else Duration.TotalHours([Post Trip] - [BOL]),
				            type number
				        ),
				
				    #"Added Missing_BOL" =
				        Table.AddColumn(
				            #"Added Hours_BOL_To_Post",
				            "Missing_BOL",
				            each if [BOL] = null then 1 else 0,
				            Int64.Type
				        ),
				
				    #"Added Missing_PreTrip" =
				        Table.AddColumn(
				            #"Added Missing_BOL",
				            "Missing_PreTrip",
				            each if [Pre Trip] = null then 1 else 0,
				            Int64.Type
				        ),
				
				    #"Added Missing_PostTrip" =
				        Table.AddColumn(
				            #"Added Missing_PreTrip",
				            "Missing_PostTrip",
				            each if [Post Trip] = null then 1 else 0,
				            Int64.Type
				        ),
				
				    #"Added DocumentStatus" =
				        Table.AddColumn(
				    #"Added Missing_PostTrip",
				    "DocumentStatus",
				    each
				        if [Pre Trip] = null and [BOL] = null and [Post Trip] = null then
				            "Missing All Documents"
				
				        else if [Pre Trip] = null and [BOL] = null then
				            "Missing Pre Trip & BOL"
				
				        else if [Pre Trip] = null and [Post Trip] = null then
				            "Missing Pre Trip & Post Trip"
				
				        else if [BOL] = null and [Post Trip] = null then
				            "Missing BOL & Post Trip"
				
				        else if [Pre Trip] = null then
				            "Missing Pre Trip"
				
				        else if [BOL] = null then
				            "Missing BOL"
				
				        else if [Post Trip] = null then
				            "Missing Post Trip"
				
				        else
				            "Complete",
				    type text
				),
				    #"Filtered Rows" = Table.SelectRows(#"Added DocumentStatus", each ([Work_Ticket] <> "PLEASE")),
				    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"Work_Ticket", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Base_Date", each List.Min(List.RemoveNulls({[BOL], [Pre Trip], [Post Trip]}))),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Base_Date", type date}}),
				    #"Uppercased Text" = Table.TransformColumns(#"Changed Type1",{{"Vertical", Text.Upper, type text}}),
				    #"Merged Queries" = Table.NestedJoin(#"Uppercased Text", {"BranchID"}, BranchKey, {"BranchID"}, "BranchKey", JoinKind.LeftOuter),
				    #"Expanded BranchKey" = Table.ExpandTableColumn(#"Merged Queries", "BranchKey", {"Base_Branch"}, {"BranchKey.Base_Branch"}),
				    #"Filtered Rows1" = Table.SelectRows(#"Expanded BranchKey", each true),
				    #"Sorted Rows" = Table.Sort(#"Filtered Rows1",{{"Work_Ticket", Order.Ascending}}),
				    #"Filtered Rows2" = Table.SelectRows(#"Sorted Rows", each true)
				in
				    #"Filtered Rows2"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

