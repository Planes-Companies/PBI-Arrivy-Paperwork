table WorkTicketPivot
	lineageTag: ccbc867e-3c3e-4141-9d73-0d07b7fc961b

	measure 'Within 24 Hours2' = ```
			
			COUNTROWS(
			    FILTER(
			        WorkTicketPivot,
			        NOT ISBLANK(WorkTicketPivot[BOL])
			            && NOT ISBLANK(WorkTicketPivot[Pre Trip])
			            && WorkTicketPivot[Hours_PreTrip_To_BOL] <= 24
			    )
			)
			
			```
		formatString: 0
		lineageTag: e3c01ba4-e3b9-4f0c-be92-a4f39a67df24

