	partition WorkTicketPivot = m
		mode: import
		source = ```
				let
				    Source = Append1,
				
				    #"Removed Columns" =
				        Table.RemoveColumns(Source,{"MSSDocumentID", "DocumentName", "SysUserFID", "DocumentTypeFID", "DocumentDescription", "Authority", "MoveTypeFID", "ProfileName", "PlanesDates.PlanesDateID", "OrderK_WorkT_Dim", "DocuSort", "DupCheck"}),
				    #"Filtered Rows2" = Table.SelectRows(#"Removed Columns", each true),
				    #"Pivoted Column" =
				        Table.Pivot(#"Filtered Rows2", List.Distinct(#"Filtered Rows2"[DocType]), "DocType", "UploadDateTime", List.Min),
				
				    #"Filtered Rows" = Table.SelectRows(#"Pivoted Column", each ([Work_Ticket] <> "PLEASE")),
				    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"Work_Ticket", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Earliest_Doc_Date", each List.Min(List.RemoveNulls({[BOL], [Pre Trip], [Post Trip]}))),
				  #"Changed Type1" =
				    Table.TransformColumnTypes(
				        #"Added Custom",
				        {{"Earliest_Doc_Date", type date}}
				    ),
				
				#"Uppercased Text" =
				    Table.TransformColumns(
				        #"Changed Type1",
				        {{"Vertical", Text.Upper, type text}}
				    ),
				
				#"Grouped Work Tickets" =
				    Table.Group(
				        #"Uppercased Text",
				        {"Work_Ticket"},
				        {
				            {"OrderFID", each List.First(List.RemoveNulls([OrderFID])), type nullable number},
				            {"Orderno", each List.First(List.RemoveNulls([Orderno])), type nullable text},
				            {"BranchID", each List.First(List.RemoveNulls([BranchID])), type nullable text},
				            {"Vertical", each List.First(List.RemoveNulls([Vertical])), type nullable text},
				            {"Move_Type", each List.First(List.RemoveNulls([Move_Type])), type nullable text},
				          
				            {"Earliest_Doc_Date", each List.First(List.RemoveNulls([Earliest_Doc_Date])), type nullable date},
				            {"FINAL_BRANCH", each List.First(List.RemoveNulls([FINAL_BRANCH])), type nullable text},
				            {"Pre Trip", each List.First(List.RemoveNulls([Pre Trip])), type nullable datetime},
				            {"BOL", each List.First(List.RemoveNulls([BOL])), type nullable datetime},
				            {"Post Trip", each List.First(List.RemoveNulls([Post Trip])), type nullable datetime}
				        }
				    ),
				    #"Added Custom1" = Table.AddColumn(#"Grouped Work Tickets", "DocumentStatus", each if [Pre Trip] = null and [BOL] = null and [Post Trip] = null then
				            "Missing All Documents"
				
				        else if [Pre Trip] = null and [BOL] = null then
				            "Missing Pre Trip & BOL"
				
				        else if [Pre Trip] = null and [Post Trip] = null then
				            "Missing Pre Trip & Post Trip"
				
				        else if [BOL] = null and [Post Trip] = null then
				            "Missing BOL & Post Trip"
				
				        else if [Pre Trip] = null then
				            "Missing Pre Trip"
				
				        else if [BOL] = null then
				            "Missing BOL"
				
				        else if [Post Trip] = null then
				            "Missing Post Trip"
				
				        else
				            "Complete"),
				    #"Added Conditional Column" = Table.AddColumn(#"Added Custom1", "Missing BOL", each if [BOL] = null then 1 else 0),
				    #"Added Conditional Column1" = Table.AddColumn(#"Added Conditional Column", "Missing Pre Trip", each if [Pre Trip] = null then 1 else 0),
				    #"Added Conditional Column2" = Table.AddColumn(#"Added Conditional Column1", "Missing Post Trip", each if [Post Trip] = null then 1 else 0),
				    #"Merged Queries" = Table.NestedJoin(#"Added Conditional Column2", {"Work_Ticket"}, LocServ, {"WkTicketNo"}, "LocServ", JoinKind.LeftOuter),
				    #"Expanded LocServ" = Table.ExpandTableColumn(#"Merged Queries", "LocServ", {"ServiceDate"}, {"ServiceDate"}),
				    #"Added Custom2" = Table.AddColumn(#"Expanded LocServ", "Days To BOL", each Duration.Days(
				Date.From([BOL]) - Date.From([ServiceDate])
				)),
				    #"Changed Type4" = Table.TransformColumnTypes(#"Added Custom2",{{"Days To BOL", Int64.Type}}),
				    #"Added Custom3" = Table.AddColumn(#"Changed Type4", "Time Pre to Post Trip", each [Post Trip] - [Pre Trip]),
				    #"Inserted Hours" = Table.AddColumn(#"Added Custom3", "Hours", each Duration.Hours([Time Pre to Post Trip]), Int64.Type),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Inserted Hours",{{"Hours", type number}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type2",{{"Hours", "Hours Pre to  Post Trip"}}),
				    #"Filtered Rows1" = Table.SelectRows(#"Renamed Columns", each true),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Filtered Rows1",{{"Missing BOL", Int64.Type}, {"Missing Pre Trip", Int64.Type}, {"Missing Post Trip", Int64.Type}})
				in
				    #"Changed Type3"
				```

