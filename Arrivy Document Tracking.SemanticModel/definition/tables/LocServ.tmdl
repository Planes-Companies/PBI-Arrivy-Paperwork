	partition LocServ = m
		mode: import
		source =
				let
				  Source = Sql.Database("PLNDS01\sql2k16", "MoversSuite2", [Query="DECLARE @Today datetime = DATEADD(day, DATEDIFF(day, 0, GETDATE()), 0);#(lf)SELECT [PriKey]#(lf)      ,[OrdPriKey]#(lf)      ,[ServiceDate]#(lf)      ,[WkTicketNo]#(lf),[BranchPriKey]#(lf)  FROM [MoversSuite2].[dbo].[LocServ]#(lf)  WHERE ServiceDate > '01-01-2026'#(lf)  AND ServiceDate < @Today#(lf)  AND WkTicketNo IS NOT Null#(lf)  ORDER BY ServiceDate DESC", HierarchicalNavigation=true]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"WkTicketNo", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

