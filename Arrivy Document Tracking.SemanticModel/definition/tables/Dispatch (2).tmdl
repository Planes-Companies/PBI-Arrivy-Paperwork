		source =
				let
				    Source = Sql.Database("PLNDS01\SQL2k16", "MoversSuite2Supp", [Query="USE [MoversSuite2Supp];#(lf)#(lf)-- Calculate the two Saturdays relative to today#(lf)DECLARE @Today    DATE  = CAST(GETDATE() AS DATE);#(lf)DECLARE @Offset   INT   = DATEPART(WEEKDAY, @Today) % 7;#(lf)SET    @Offset   = CASE WHEN @Offset = 0 THEN 7 ELSE @Offset END;#(lf)DECLARE @EndDt    DATE#(lf)DECLARE @StartDt  DATE#(lf)#(lf) Set @StartDt ='2026-06-28';#(lf) Set @EndDt = @Today;#(lf)#(lf)SET NOCOUNT ON;#(lf)DECLARE @Interim table #(lf)#(tab)(EquipNo varchar(40),#(lf)#(tab)EquipType varchar(100),#(lf)#(tab)EqStatus varchar(100),#(lf)#(tab)Branch varchar(100),#(lf)#(tab)Owner varchar(100),#(lf)    OrderNo varchar(20),#(lf)#(tab)Ordprikey INT,#(lf)#(tab)ServiceType varchar(200),#(lf)#(tab)ServiceID varchar(100),#(lf)#(tab)ShipperName varchar(100), #(lf)    LocSerPriKey VARCHAR (50), #(lf)#(tab)ScheduledStart datetime,#(lf)#(tab)ServiceDate datetime,#(lf)#(tab)BranchPriKey int,#(lf)#(tab)ServiceBranch varchar(50))#(lf)#(lf)#(tab)insert into @Interim#(lf)          select #(lf)#(tab)#(tab)  Equip.EqNo,#(lf)#(tab)#(tab)  EqType.Type,#(lf)#(tab)#(tab)  Equip.EqStatus,#(lf)#(tab)#(tab) CASE#(lf)           WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo)) = '1840' THEN 'Cincinnati'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo)) = '40' THEN 'Cincinnati'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '140' THEN 'Indianapolis'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))='1843' THEN 'Indianapolis'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '340' THEN 'Chicago'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '35' THEN 'Columbus'#(lf)#(tab)#(tab)   WHEN SUBSTRING(Equip.EqNo, CHARINDEX('-', Equip.EqNo) + LEN('-'), LEN(Equip.EqNo))= '402' THEN 'Dayton'#(lf)#(tab)#(tab)   WHEN ISNULL(Equip.EqNo,'') like 'Hogan%' THEN 'Cincinnati'#(lf)#(tab)#(tab)   WHEN ISNULL(Equip.EqNo,'') like '%Ideal%' THEN 'Columbus'#(lf)#(tab)#(tab)   --WHEN ISNULL(Equip.EqNo,'') like 'Rental%' THEN 'Cincinnati'#(lf)#(tab)#(tab)   --WHEN ISNULL(Equip.EqNo,'') like 'R%' THEN 'Cincinnati'#(lf)           ELSE ''#(lf)        END AS branch,#(lf)#(tab)#(tab)   Equip.RegisteredOwner,#(lf)#(tab)#(tab)  VWO.OrderNo, #(lf)#(tab)#(tab)  VWO.OrdPriKey,#(lf)#(tab)#(tab)  ServType.Service,#(lf)#(tab)#(tab)  ServType.ServiceID,#(lf)          VWO.Shipper AS ShipperName,#(lf)          LS.PriKey LocServPriKey, #(lf)          LSE.ScheduledStart,#(lf)#(tab)#(tab)  LS.ServiceDate,#(lf)#(tab)#(tab)  LS.BranchPriKey,#(lf)#(tab)#(tab)  BL.Name#(lf)   from MoversSuite2..Equip #(lf)   left join MoversSuite2..LocalServicesEquipment LSE#(lf)      on Equip.EqNo = LSE.EquipmentNumber#(lf)   left join MoversSuite2..EqType #(lf)      on Equip.Type=EqType.TypeNumber#(lf)   Left join MoversSuite2..LocServ LS#(lf)      on LSE.LocalServicesEquipmentLocServFID = LS.PriKey#(lf)#(tab)Left join MoversSuite2..Branch BL#(lf)#(tab)#(tab)on LS.BranchPriKey = BL.BranchPriKey#(lf)   Left join MoversSuite2Supp..vwOrdersDataset VWO#(lf)      on LS.OrdPriKey = VWO.OrdPriKey#(lf)   left join MoversSuite2..LocalServicesCrew#(lf)      on LS.PriKey = LocalServicesCrew.LocalServicesCrewLocServFID #(lf)      and LeadMan = 1#(lf)   left join MoversSuite2..ServType#(lf)      on LS.ServiceID = ServType.ServiceID #(lf) where LSE.ScheduledStart between @StartDt and @EndDt#(lf) and Equip.EqStatus='1'#(lf)  and ServType.Service not in ('Vaulted storage','Intl transload','Training','Non-billable',                                       #(lf)                                'WHSE SIT In', 'WHSE SIT Out')#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='889-402'#(lf)#(lf)Update @Interim#(lf)Set Branch='Columbus'#(lf)Where EquipNo='805-402'#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='Hogan 252111'#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='Hogan 252172'#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='Hogan242130'#(lf)#(lf)Update @Interim#(lf)Set EquipNo='Hogan 242130'#(lf)Where EquipNo='Hogan242130'#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='826-140'#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='897-40'#(lf)#(lf)Update @Interim#(lf)Set Branch='Cincinnati'#(lf)Where EquipNo='Hogan 256097'#(lf)#(lf)#(lf)select * FROM @Interim#(lf)         where ServiceID is not null#(lf) AND ScheduledStart > '2026-06-27'", HierarchicalNavigation=true]),
