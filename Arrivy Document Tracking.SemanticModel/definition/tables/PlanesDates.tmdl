	partition PlanesDates = m
		mode: import
		source =
				let
				    Source = Sql.Database("PLNDS01\Sql2k16", "MoversSuite2Supp", [Query="Select * FROM PlanesDates #(lf)Where Date > '12-30-2025'"]),
				    #"Extracted Date" = Table.TransformColumns(Source,{{"Date", DateTime.Date, type date}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Extracted Date",{"PlanesCheckDt", "GWSCheckDt"}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Removed Columns", "Merged", each Text.Combine({"Q", [Quarter]}), type text),
				    #"Added Custom" = Table.AddColumn(#"Inserted Merged Column", "WEEK_OF", each Date.StartOfWeek([Date], Day.Sunday), type date)
				in
				    #"Added Custom"

